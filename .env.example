# Runtime values are managed in Sites. No real secrets belong in source control.
# Set only after the business domain has working DNS/TLS. Empty keeps the review origin.
PUBLIC_SITE_ORIGIN=
CMS_BOOTSTRAP_EMAIL=info@itdks.tech
# Salted password hash only; configure as a secret. Never put a plaintext password here.
CMS_BOOTSTRAP_PASSWORD_HASH=
CMS_NOTIFY_EMAIL=info@itdks.tech
# One-time approved launch action; persisted audit marker preserves later CMS toggles.
CMS_ACTIVATE_INQUIRIES=
# Optional transactional email integration; configure a verified sender before enabling.
CMS_EMAIL_FROM=
CMS_EMAIL_API_KEY=
